PORT=5000
MONGO_URI=mongodb://localhost:27017/tiktok-auth
JWT_SECRET=une_chaine_super_secrete
REFRESH_TOKEN_SECRET=une_autre_chaine_super_secrete
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=ton_google_client_id
GOOGLE_CLIENT_SECRET=ton_google_client_secret

# Facebook OAuth
FB_CLIENT_ID=ton_facebook_app_id
FB_CLIENT_SECRET=ton_facebook_app_secret

# Apple OAuth (à configurer)
APPLE_CLIENT_ID=ton_apple_service_id
APPLE_TEAM_ID=ton_apple_team_id
APPLE_KEY_ID=ton_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTON_APPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# SMS Service (Twilio ou autre - optionnel pour le développement)
TWILIO_ACCOUNT_SID=ton_twilio_account_sid
TWILIO_AUTH_TOKEN=ton_twilio_auth_token
TWILIO_PHONE_NUMBER=ton_numero_twilio

NODE_ENV=development